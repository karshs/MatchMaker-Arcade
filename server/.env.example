# ─────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Neon DB — get this from your Neon console (Project → Connection Details → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/matchmaker?sslmode=require

# JWT — generate a strong random secret for production
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Hardcoded Matchmaker Credentials (mock auth) ──
ADMIN_EMAIL=admin@matchmaker.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Priya Kapoor

# OpenAI — get from platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Set to "mock" to use mock AI responses without an API key
AI_MODE=mock
